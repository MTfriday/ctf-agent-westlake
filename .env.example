# ========== 比赛平台 ==========
# CTFd 模式
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here
CTFD_USER=admin
CTFD_PASS=admin

# 平台认证凭证（SECRET — 根据 config.yaml 的 platform.type 使用）
# CTF2 模式: PersonalAccessToken，通过 X-CTF2-API-Key header 发送
PLATFORM_AUTH_CREDENTIAL=ctf2_your_token_here

# GZCTF 模式（推荐用 token，避免存密码）
GZCTF_TOKEN=
GZCTF_USERNAME=
GZCTF_PASSWORD=

# ========== LLM API Keys ==========
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini
GEMINI_API_KEY=...

# DeepSeek (OpenAI 兼容接口)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里百炼 (OpenAI 兼容接口)
BAILIAN_API_KEY=sk-...
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# AWS Bedrock
AWS_REGION=us-east-1
AWS_BEARER_TOKEN=

# OpenCode Zen
OPENCODE_ZEN_API_KEY=

# ========== 求解器 ==========
FLAG_PATTERN=                        # Flag 校验正则（留空=不校验）
MAX_CONCURRENT_CHALLENGES=10
MAX_ATTEMPTS_PER_CHALLENGE=3
RATE_LIMIT_RPS=5

# 模型选择（逗号分隔，留空=自动检测可用provider）
# 没有 claude/codex CLI 时会自动回退到 OpenAI 兼容 API
# 示例: MODELS=deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro,bailian/qwen-max
MODELS=
